{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "referral_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "kiosk",
        "patient_app"
      ]
    },
    "kiosk_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "symptoms": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "free_text_summary": {
      "type": "string",
      "maxLength": 4000
    },
    "patient_language_summary": {
      "type": "string",
      "maxLength": 4000
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "risk_band": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "recommended_specialty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "letter_scan": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "extracted_text": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "present",
        "extracted_text"
      ],
      "additionalProperties": false
    },
    "lesion_photo": {
      "type": "object",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "assessment": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 10000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "present",
        "assessment"
      ],
      "additionalProperties": false
    },
    "voice_research": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "flagged",
            "not_flagged",
            "inconclusive"
          ]
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sample_duration_seconds": {
          "type": "number",
          "minimum": 2,
          "maximum": 12
        },
        "research_only": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "outcome",
        "assessed_at",
        "model_id",
        "model_version",
        "sample_duration_seconds",
        "research_only"
      ],
      "additionalProperties": false
    },
    "signature_template_encrypted": {
      "type": "string",
      "minLength": 40,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "triage_detail_encrypted": {
      "type": "string",
      "minLength": 40,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "salt": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "commitment_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "spent",
        "expired"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "referral_id",
    "created_at",
    "source",
    "kiosk_id",
    "language",
    "symptoms",
    "free_text_summary",
    "patient_language_summary",
    "risk_score",
    "risk_band",
    "recommended_specialty",
    "letter_scan",
    "lesion_photo",
    "signature_template_encrypted",
    "triage_detail_encrypted",
    "salt",
    "commitment_hash",
    "status",
    "expires_at"
  ],
  "additionalProperties": false
}
