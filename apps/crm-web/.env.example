DEMO_MODE=true
CHAIN=mock
LLM=ondevice
# Local synthetic data only. Relative to apps/crm-web.
EDGECARE_DB_PATH=.data/edgecare.sqlite
# Optional demo device authorization. Set both for any LAN/non-loopback use.
# Browser CRM sessions open automatically without a code; tokens protect device API calls.
# EDGECARE_CLINICIAN_TOKEN=replace-with-random-demo-clinician-token
# EDGECARE_ISSUER_TOKEN=replace-with-random-demo-issuer-token

# Optional consent-gated connected-demo conversation. Offline flows never call it.
EDGECARE_CLOUD_VOICE=false
# Streaming speech: Google Gemini Live replaces separate ElevenLabs STT/TTS calls.
# A configured Google key selects Live automatically; legacy explicitly opts out.
# EDGECARE_VOICE_ENGINE=gemini_live
# GEMINI_API_KEY=server-only-key
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Legacy turn API and structured-form normalization configuration:
# GEMINI_MODEL=choose-a-current-model-with-structured-JSON-support
# Alternatively use Gemini through Runware (verified structured output model):
# VOICE_LLM_PROVIDER=runware
# RUNWARE_API_KEY=server-only-key
# RUNWARE_MODEL=google:gemini@3-flash
# ELEVENLABS_API_KEY=server-only-key
# ELEVENLABS_VOICE_ID=selected-multilingual-voice-id
ELEVENLABS_STT_MODEL=scribe_v2
# v3 supports Somali, Finnish, Arabic, Russian and English. multilingual_v2 excludes Somali.
ELEVENLABS_TTS_MODEL=eleven_v3
# Optional selected voice override for a language; does not clone the patient's voice.
# ELEVENLABS_VOICE_ID_SO=selected-somali-voice-id
# Verified initial language selections; see docs/voice-selection.md:
# ELEVENLABS_VOICE_ID_EN=MFZUKuGQUsGJPQjTS4wC
# ELEVENLABS_VOICE_ID_FI=paqSK057kuKFy1kq3bdZ
# ELEVENLABS_VOICE_ID_SO=nPczCjzI2devNBz1zQrb
# ELEVENLABS_VOICE_ID_AR=QsV9PCczMIklRM6xLPAS
# ELEVENLABS_VOICE_ID_RU=qJBO8ZmKp4te7NTtYgzz
# Only enable if the ElevenLabs account has zero-retention entitlement.
ELEVENLABS_ZERO_RETENTION=false

# Hosted deployment: durable Neon database, stable session signing and HTTPS origin.
# DATABASE_URL=server-only-postgres-url
# EDGECARE_SESSION_SECRET=at-least-32-random-characters
# EDGECARE_PUBLIC_ORIGIN=https://your-project.vercel.app
