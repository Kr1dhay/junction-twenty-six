DEMO_MODE=true
CHAIN=mock
LLM=ondevice
# Local synthetic data only. Relative to apps/crm-web.
EDGECARE_DB_PATH=.data/edgecare.sqlite
# Optional demo device authorization. Set both for any LAN/non-loopback use.
# A configured clinician token also protects creation of browser demo sessions.
# EDGECARE_CLINICIAN_TOKEN=replace-with-random-demo-clinician-token
# EDGECARE_ISSUER_TOKEN=replace-with-random-demo-issuer-token

# Optional consent-gated connected-demo conversation. Offline flows never call it.
EDGECARE_CLOUD_VOICE=false
# GEMINI_API_KEY=server-only-key
# GEMINI_MODEL=choose-a-current-model-with-structured-JSON-support
# ELEVENLABS_API_KEY=server-only-key
# ELEVENLABS_VOICE_ID=selected-multilingual-voice-id
ELEVENLABS_STT_MODEL=scribe_v2
# v3 supports Somali, Finnish, Arabic, Russian and English. multilingual_v2 excludes Somali.
ELEVENLABS_TTS_MODEL=eleven_v3
# Optional selected voice override for a language; does not clone the patient's voice.
# ELEVENLABS_VOICE_ID_SO=selected-somali-voice-id
# Only enable if the ElevenLabs account has zero-retention entitlement.
ELEVENLABS_ZERO_RETENTION=false
